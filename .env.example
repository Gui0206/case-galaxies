# Local execution. Relative paths resolve from the repository root.
GALAXIES_WORKSPACE=.runtime
GALAXIES_HOST=127.0.0.1
GALAXIES_PORT=8000
# Required when exposing the HTTP service beyond loopback.
# GALAXIES_API_TOKEN=replace-with-a-long-random-value
# Optional metadata collection (never downloads YouTube video files).
# YOUTUBE_API_KEY=
# Optional structured visual extraction through a local Ollama server.
# GALAXIES_VLM_URL=http://127.0.0.1:11434
# GALAXIES_VLM_MODEL=qwen2.5vl:7b
# Optional tracking; install with uv sync --extra tracking.
# MLFLOW_TRACKING_URI=file:./mlruns
