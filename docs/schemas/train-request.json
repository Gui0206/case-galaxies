{
  "$defs": {
    "TrainConfig": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "default": "catboost",
          "enum": [
            "catboost",
            "ridge",
            "lightgbm",
            "blend"
          ],
          "title": "Family",
          "type": "string"
        },
        "target_mode": {
          "default": "absolute",
          "enum": [
            "absolute",
            "channel_residual"
          ],
          "title": "Target Mode",
          "type": "string"
        },
        "channel_weighting": {
          "default": "uniform",
          "enum": [
            "uniform",
            "balanced"
          ],
          "title": "Channel Weighting",
          "type": "string"
        },
        "l2_regularization": {
          "default": 3,
          "minimum": 0,
          "title": "L2 Regularization",
          "type": "number"
        },
        "ridge_alpha": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Ridge Alpha",
          "type": "number"
        },
        "blend_weight": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Blend Weight",
          "type": "number"
        },
        "sector_calibration": {
          "default": true,
          "title": "Sector Calibration",
          "type": "boolean"
        },
        "min_sector_calibration": {
          "default": 40,
          "minimum": 20,
          "title": "Min Sector Calibration",
          "type": "integer"
        },
        "iterations": {
          "default": 240,
          "maximum": 2000,
          "minimum": 20,
          "title": "Iterations",
          "type": "integer"
        },
        "depth": {
          "default": 5,
          "maximum": 8,
          "minimum": 2,
          "title": "Depth",
          "type": "integer"
        },
        "learning_rate": {
          "default": 0.06,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Learning Rate",
          "type": "number"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        },
        "coverage": {
          "default": 0.9,
          "maximum": 0.99,
          "minimum": 0.5,
          "title": "Coverage",
          "type": "number"
        },
        "feature_blocks": {
          "items": {
            "enum": [
              "context",
              "text",
              "visual",
              "rubric"
            ],
            "type": "string"
          },
          "title": "Feature Blocks",
          "type": "array"
        },
        "held_out_channels": {
          "items": {
            "type": "string"
          },
          "title": "Held Out Channels",
          "type": "array"
        },
        "min_train_rows": {
          "default": 60,
          "minimum": 20,
          "title": "Min Train Rows",
          "type": "integer"
        }
      },
      "title": "TrainConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/TrainConfig"
    }
  },
  "required": [
    "dataset"
  ],
  "title": "TrainRequest",
  "type": "object"
}
