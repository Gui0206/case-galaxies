{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "title": "Attribute",
          "type": "string"
        },
        "observation": {
          "maxLength": 1000,
          "title": "Observation",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "minimum": 0,
          "title": "End Seconds",
          "type": "number"
        }
      },
      "required": [
        "attribute",
        "observation",
        "start_seconds",
        "end_seconds"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "creative_id": {
      "maxLength": 150,
      "minLength": 1,
      "title": "Creative Id",
      "type": "string"
    },
    "attributes_source": {
      "default": "human_annotation",
      "enum": [
        "media_extraction",
        "human_annotation",
        "simulation"
      ],
      "title": "Attributes Source",
      "type": "string"
    },
    "caption": {
      "default": "",
      "maxLength": 10000,
      "title": "Caption",
      "type": "string"
    },
    "transcript": {
      "default": "",
      "maxLength": 30000,
      "title": "Transcript",
      "type": "string"
    },
    "features": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Features",
      "type": "object"
    },
    "visual_embedding": {
      "items": {
        "type": "number"
      },
      "maxItems": 2048,
      "title": "Visual Embedding",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 100,
      "title": "Evidence",
      "type": "array"
    },
    "media_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Id"
    },
    "channel_id": {
      "maxLength": 150,
      "minLength": 1,
      "title": "Channel Id",
      "type": "string"
    },
    "sector": {
      "enum": [
        "beleza",
        "automotivo",
        "moda"
      ],
      "title": "Sector",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "features_available_at": {
      "format": "date-time",
      "title": "Features Available At",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "metric": {
      "default": "likes",
      "enum": [
        "likes",
        "views"
      ],
      "title": "Metric",
      "type": "string"
    },
    "horizon_days": {
      "default": 7,
      "maximum": 90,
      "minimum": 1,
      "title": "Horizon Days",
      "type": "integer"
    },
    "target": {
      "minimum": 0,
      "title": "Target",
      "type": "integer"
    },
    "subscribers": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subscribers"
    },
    "channel_stats_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Channel Stats Observed At"
    },
    "content_hash": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Content Hash",
      "type": "string"
    },
    "content_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Group"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "usage_basis": {
      "minLength": 1,
      "title": "Usage Basis",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "language": {
      "default": "pt",
      "title": "Language",
      "type": "string"
    },
    "distribution": {
      "default": "unknown",
      "enum": [
        "organic",
        "paid",
        "unknown"
      ],
      "title": "Distribution",
      "type": "string"
    }
  },
  "required": [
    "creative_id",
    "channel_id",
    "sector",
    "published_at",
    "features_available_at",
    "observed_at",
    "target",
    "content_hash",
    "source",
    "usage_basis"
  ],
  "title": "PostRecord",
  "type": "object"
}
